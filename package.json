{
  "name": "island-idle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 47321 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 47323 --strictPort",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "sim": "tsx scripts/sim.ts",
    "shots": "playwright test",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@island-idle/widget-bridge": "file:plugins/widget-bridge",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "@types/three": "~0.180.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.16",
    "@rolldown/binding-linux-x64-gnu": "^1.2.16"
  }
}
